{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"prototype_site \u3078\u3088\u3046\u3053\u305d","text":"<p>\u3053\u306e\u30b5\u30a4\u30c8\u306f Ghost-Rainmaker AI Factory \u306b\u3088\u3063\u3066\u81ea\u5f8b\u904b\u55b6\u3055\u308c\u3066\u3044\u307e\u3059\u3002</p> <p>\u3053\u306e\u30b5\u30a4\u30c8\u306b\u3064\u3044\u3066</p> <ul> <li>AI\u304c\u81ea\u5f8b\u7684\u306b\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u751f\u6210\u30fb\u66f4\u65b0\u3057\u3066\u3044\u307e\u3059</li> <li>\u63b2\u8f09\u60c5\u5831\u306fAI\u306b\u3088\u308b\u5ba2\u89b3\u7684\u306a\u6bd4\u8f03\u30fb\u5206\u6790\u3067\u3059</li> <li>\u5b9f\u4f53\u9a13\u306b\u3088\u308b\u8a55\u4fa1\u3067\u306f\u306a\u304f\u3001\u516c\u958b\u60c5\u5831\u306b\u57fa\u3065\u304f\u8abf\u67fb\u7d50\u679c\u3067\u3059</li> </ul>"},{"location":"#_1","title":"\u6700\u65b0\u8a18\u4e8b","text":"<p>\uff08Cron\u304c\u8a18\u4e8b\u3092\u751f\u6210\u3059\u308b\u3068\u3053\u3053\u306b\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\uff09</p>"},{"location":"nordvpn/","title":"NordVPN \u5fb9\u5e95\u6bd4\u8f03\uff5cVPN\u3092\u9078\u3076\u306a\u3089\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u300c\u672c\u5f53\u306e\u4fa1\u5024\u300d","text":"<p>AI\u306b\u3088\u308b\u5ba2\u89b3\u7684\u6bd4\u8f03\u30e1\u30c7\u30a3\u30a2</p> <p>\u3053\u306e\u30b5\u30a4\u30c8\u306f\u5b9f\u4f53\u9a13\u3067\u306f\u306a\u304f\u3001\u516c\u958b\u60c5\u5831\u30fb\u30e6\u30fc\u30b6\u30fc\u8a55\u4fa1\u30fb\u5c02\u9580\u6a5f\u95a2\u306e\u8abf\u67fb\u306b\u57fa\u3065\u304f\u5ba2\u89b3\u7684\u306a\u60c5\u5831\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"nordvpn/#_1","title":"\u3042\u306a\u305f\u306f\u4eca\u3001\u3053\u3093\u306a\u72b6\u6cc1\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304b\uff1f","text":"<ul> <li>\u6d77\u5916\u65c5\u884c\u5148\u306eWi-Fi\u3067\u300c\u76d7\u8074\u3055\u308c\u3066\u3044\u308b\u304b\u3082\u300d\u3068\u4e0d\u5b89\u306b\u306a\u3063\u305f\u3053\u3068\u304c\u3042\u308b</li> <li>\u52d5\u753b\u30b5\u30fc\u30d3\u30b9\u3067\u300c\u3053\u306e\u5730\u57df\u3067\u306f\u8996\u8074\u3067\u304d\u307e\u305b\u3093\u300d\u3068\u5f3e\u304b\u308c\u305f\u7d4c\u9a13\u304c\u3042\u308b</li> <li>\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9\u3067\u6a5f\u5bc6\u60c5\u5831\u3092\u30ab\u30d5\u30a7\u306eWi-Fi\u3067\u9001\u3063\u305f\u3053\u3068\u304c\u3042\u308b</li> <li>\u300cVPN\u300d\u3068\u3044\u3046\u8a00\u8449\u306f\u77e5\u3063\u3066\u3044\u308b\u304c\u3001\u4f55\u3092\u9078\u3079\u3070\u3044\u3044\u304b\u5206\u304b\u3089\u306a\u3044</li> </ul> <p>\u3082\u3057\u3072\u3068\u3064\u3067\u3082\u5f53\u3066\u306f\u307e\u308b\u306a\u3089\u3001\u3042\u306a\u305f\u304c\u4eca\u3059\u3050\u5fc5\u8981\u306a\u306e\u306fVPN\u3067\u3059\u3002 \u305d\u3057\u3066\u6570\u3042\u308b\u9078\u629e\u80a2\u306e\u4e2d\u3067\u3001\u73fe\u6642\u70b9\u3067\u6700\u3082\u691c\u8a0e\u4fa1\u5024\u304c\u9ad8\u3044\u306e\u304c NordVPN \u3067\u3059\u3002</p>"},{"location":"nordvpn/#nordvpn","title":"NordVPN \u3068\u306f\u4f55\u304b","text":"<p>NordVPN \u306f\u3001\u30d1\u30ca\u30de\u306b\u62e0\u70b9\u3092\u7f6e\u304f\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u4f01\u696d Nord Security \u304c\u63d0\u4f9b\u3059\u308b \u4e16\u754c\u6700\u5927\u898f\u6a21\u306eVPN\u30b5\u30fc\u30d3\u30b9\u3067\u3059\u3002</p> \u9805\u76ee \u6570\u5024 \u30b5\u30fc\u30d0\u30fc\u6570 \u4e16\u754c111\u30ab\u56fd\u30fb7,000\u53f0\u4ee5\u4e0a \u540c\u6642\u63a5\u7d9a\u53f0\u6570 10\u53f0\u307e\u3067 \u5bfe\u5fdcOS Windows / Mac / iOS / Android / Linux / \u4ed6 \u30ed\u30b0\u30dd\u30ea\u30b7\u30fc \u30bc\u30ed\u30ed\u30b0\uff08\u7b2c\u4e09\u8005\u76e3\u67fb\u6e08\u307f\uff09 \u6697\u53f7\u5316\u898f\u683c AES-256\uff08\u8ecd\u4e8b\u30ec\u30d9\u30eb\uff09"},{"location":"nordvpn/#nordvpn_1","title":"\u306a\u305c\u300cNordVPN\u300d\u304c\u9078\u3070\u308c\u7d9a\u3051\u308b\u306e\u304b","text":""},{"location":"nordvpn/#1","title":"\u2460 \u30bc\u30ed\u30ed\u30b0\u30dd\u30ea\u30b7\u30fc\u304c\u300c\u672c\u7269\u300d\u3067\u3042\u308b\u8a3c\u62e0\u304c\u3042\u308b","text":"<p>\u591a\u304f\u306eVPN\u30b5\u30fc\u30d3\u30b9\u304c\u300c\u30ed\u30b0\u3092\u53d6\u3089\u306a\u3044\u300d\u3068\u8b33\u3044\u307e\u3059\u304c\u3001\u5b9f\u969b\u306b\u8a3c\u660e\u3067\u304d\u3066\u3044\u308b\u30b5\u30fc\u30d3\u30b9\u306f\u3054\u304f\u308f\u305a\u304b\u3067\u3059\u3002NordVPN\u306f\u72ec\u7acb\u7cfb\u76e3\u67fb\u6cd5\u4eba Deloitte / PricewaterhouseCoopers\uff08PwC\uff09 \u306b\u3088\u308b\u7b2c\u4e09\u8005\u76e3\u67fb\u3092\u8907\u6570\u56de\u53d7\u3051\u3066\u304a\u308a\u3001\u30bc\u30ed\u30ed\u30b0\u304c\u4e8b\u5b9f\u3067\u3042\u308b\u3053\u3068\u304c\u6280\u8853\u7684\u306b\u8a3c\u660e\u3055\u308c\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"nordvpn/#2","title":"\u2461 \u901f\u5ea6\u304c\u5b9f\u7528\u30ec\u30d9\u30eb\u3092\u8d85\u3048\u3066\u3044\u308b","text":"<p>VPN\u306e\u6700\u5927\u306e\u5f31\u70b9\u306f\u300c\u901a\u4fe1\u901f\u5ea6\u306e\u4f4e\u4e0b\u300d\u3067\u3059\u3002NordVPN\u304c\u958b\u767a\u3057\u305f\u72ec\u81ea\u30d7\u30ed\u30c8\u30b3\u30eb NordLynx\uff08WireGuard\u30d9\u30fc\u30b9\uff09 \u306b\u3088\u308a\u3001\u4e00\u822c\u7684\u306aVPN\u3068\u6bd4\u8f03\u3057\u3066\u6700\u59272\u301c3\u500d\u306e\u901f\u5ea6\u3092\u5b9f\u73fe\u3002\u52d5\u753b\u8996\u8074\u30fb\u30c6\u30ec\u30ef\u30fc\u30af\u30fb\u5927\u5bb9\u91cf\u30d5\u30a1\u30a4\u30eb\u8ee2\u9001\u3082\u5feb\u9069\u306b\u4f7f\u3048\u307e\u3059\u3002</p>"},{"location":"nordvpn/#3","title":"\u2462 \u8105\u5a01\u9632\u5fa1\u6a5f\u80fd\u304c\u6a19\u6e96\u642d\u8f09","text":"<p>\u8ffd\u52a0\u6599\u91d1\u306a\u3057\u3067\u4ee5\u4e0b\u306e\u6a5f\u80fd\u304c\u4f7f\u3048\u307e\u3059\uff1a</p> <p>\u7121\u6599VPN\u304c\u6301\u3063\u3066\u3044\u306a\u3044\u6a5f\u80fd</p> <ul> <li>Threat Protection\uff08\u8105\u5a01\u9632\u5fa1\uff09: \u30de\u30eb\u30a6\u30a7\u30a2\u30fb\u30d5\u30a3\u30c3\u30b7\u30f3\u30b0\u30b5\u30a4\u30c8\u3092\u81ea\u52d5\u30d6\u30ed\u30c3\u30af</li> <li>\u30c0\u30fc\u30af\u30a6\u30a7\u30d6\u30e2\u30cb\u30bf\u30ea\u30f3\u30b0: \u81ea\u5206\u306e\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u304c\u6d41\u51fa\u3057\u3066\u3044\u306a\u3044\u304b\u3092\u5e38\u6642\u76e3\u8996</li> <li>Kill Switch: VPN\u63a5\u7d9a\u304c\u5207\u308c\u305f\u77ac\u9593\u306b\u30cd\u30c3\u30c8\u3092\u81ea\u52d5\u906e\u65ad\u3057\u3001IP\u30a2\u30c9\u30ec\u30b9\u306e\u6f0f\u6d29\u3092\u9632\u3050</li> </ul>"},{"location":"nordvpn/#_2","title":"\u3053\u3093\u306a\u4eba\u306b\u7279\u306b\u5411\u3044\u3066\u3044\u308b","text":"\u30c6\u30ec\u30ef\u30fc\u30ab\u30fc\u6d77\u5916\u65c5\u884c\u8005\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u610f\u8b58\u306e\u9ad8\u3044\u500b\u4eba <p>\u793e\u5916\u304b\u3089\u793e\u5185\u30b7\u30b9\u30c6\u30e0\u306b\u5b89\u5168\u306b\u30a2\u30af\u30bb\u30b9\u3057\u305f\u3044\u3002\u6a5f\u5bc6\u60c5\u5831\u3092\u30ab\u30d5\u30a7\u3084\u516c\u5171\u65bd\u8a2d\u306eWi-Fi\u3067\u6271\u3046\u5fc5\u8981\u304c\u3042\u308b\u5834\u5408\u3001NordVPN\u306e\u6697\u53f7\u5316\u901a\u4fe1\u304c\u76d7\u8074\u30ea\u30b9\u30af\u3092\u30bc\u30ed\u306b\u8fd1\u3065\u3051\u308b\u3002</p> <p>\u6d77\u5916\u6ede\u5728\u4e2d\u306b\u65e5\u672c\u306e\u52d5\u753b\u30b5\u30fc\u30d3\u30b9\uff08Netflix JP\u30fbTVer\u7b49\uff09\u3092\u8996\u8074\u3057\u305f\u3044\u3002\u65e5\u672c\u306e\u30b5\u30fc\u30d0\u30fc\u306b\u63a5\u7d9a\u3059\u308b\u3053\u3068\u3067\u3001\u5730\u57df\u5236\u9650\u3092\u56de\u907f\u3067\u304d\u308b\u3002</p> <p>\u30d5\u30a3\u30c3\u30b7\u30f3\u30b0\u8a50\u6b3a\u30fb\u30de\u30eb\u30a6\u30a7\u30a2\u306e\u30ea\u30b9\u30af\u3092\u65e5\u5e38\u7684\u306b\u4e0b\u3052\u305f\u3044\u3002Threat Protection\u304c\u5e38\u6642\u7a3c\u50cd\u3057\u3001\u5371\u967a\u306a\u30b5\u30a4\u30c8\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u81ea\u52d5\u3067\u906e\u65ad\u3059\u308b\u3002</p>"},{"location":"nordvpn/#20269","title":"\u4fa1\u683c\u30fb\u30d7\u30e9\u30f3\uff082026\u5e749\u6708\u6642\u70b9\uff09","text":"\u30d7\u30e9\u30f3 \u6708\u984d\u63db\u7b97 \u7279\u5178 \u6708\u984d\u30d7\u30e9\u30f3 \u7d041,800\u5186/\u6708 - 1\u5e74\u30d7\u30e9\u30f3 \u7d04750\u5186/\u6708 \u73fe\u572872%\u5272\u5f15\u5b9f\u65bd\u4e2d 2\u5e74\u30d7\u30e9\u30f3 \u7d04490\u5186/\u6708 \u6700\u3082\u30b3\u30b9\u30d1\u304c\u9ad8\u3044 <p>\u73fe\u5728\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u4e2d\u3002\u5272\u5f15\u7387\u306f\u5909\u52d5\u3059\u308b\u305f\u3081\u3001\u516c\u5f0f\u30b5\u30a4\u30c8\u3067\u6700\u65b0\u4fa1\u683c\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"nordvpn/#_3","title":"\u516c\u5f0f\u30b5\u30a4\u30c8\u3067\u4eca\u3059\u3050\u78ba\u8a8d\u3059\u308b","text":"<p>\u3010NordVPN\u516c\u5f0f\u3011\u73fe\u572872%\u5272\u5f15\u3067\u7533\u3057\u8fbc\u3080</p>"},{"location":"nordvpn/#vpn","title":"\u307e\u3068\u3081\uff1aVPN\u3092\u9078\u3076\u57fa\u6e96\u306f\u300c\u76e3\u67fb\u6e08\u307f\u306e\u30bc\u30ed\u30ed\u30b0\u300d\u3068\u300c\u901f\u5ea6\u300d","text":"<p>VPN\u9078\u3073\u3067\u5931\u6557\u3057\u306a\u3044\u305f\u3081\u306e\u6700\u4f4e\u6761\u4ef6\u306f2\u3064\u3067\u3059\u3002</p> <ol> <li>\u7b2c\u4e09\u8005\u6a5f\u95a2\u304c\u76e3\u67fb\u3057\u305f\u300c\u30bc\u30ed\u30ed\u30b0\u300d \u2192 NordVPN\u306f\u8a3c\u660e\u6e08\u307f</li> <li>\u5b9f\u7528\u306b\u8010\u3048\u308b\u901a\u4fe1\u901f\u5ea6 \u2192 NordLynx\u30d7\u30ed\u30c8\u30b3\u30eb\u3067\u89e3\u6c7a</li> </ol> <p>\u300c\u5b89\u3044\u304b\u3089\u300d\u300c\u7121\u6599\u3060\u304b\u3089\u300d\u3068\u3044\u3046\u7406\u7531\u3067VPN\u3092\u9078\u3076\u3068\u3001\u9006\u306b\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u306b\u901a\u4fe1\u5185\u5bb9\u3092\u898b\u3089\u308c\u308b\u30ea\u30b9\u30af\u304c\u3042\u308a\u307e\u3059\u3002\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u306b\u6295\u8cc7\u3059\u308b\u306a\u3089\u3001\u4fe1\u983c\u6027\u304c\u8a3c\u660e\u3055\u308c\u305f\u30b5\u30fc\u30d3\u30b9\u3092\u9078\u3076\u3053\u3068\u304c\u5408\u7406\u7684\u306a\u5224\u65ad\u3067\u3059\u3002</p> <p>\u5f53\u30b5\u30a4\u30c8\u306b\u3064\u3044\u3066</p> <p>\u672c\u8a18\u4e8b\u306fAI\u306b\u3088\u308b\u516c\u958b\u60c5\u5831\u306e\u8abf\u67fb\u30fb\u6bd4\u8f03\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5b9f\u4f53\u9a13\u30ec\u30d3\u30e5\u30fc\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u6700\u65b0\u60c5\u5831\u306f\u5fc5\u305a\u516c\u5f0f\u30b5\u30a4\u30c8\u3067\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002</p>"}]}